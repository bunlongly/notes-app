# API Configuration
VITE_API_URL=http://localhost:5000/api

# Token Storage Configuration
# localStorage: Easy debugging, see tokens in DevTools (DEVELOPMENT)
# httpOnly cookies: Secure, XSS-protected (PRODUCTION)

# Current: Development mode (localStorage)
VITE_USE_COOKIES=false

# To enable production mode (httpOnly cookies):
# 1. Uncomment line below
# 2. Set backend appsettings.json "Auth:UseCookies" to true
# 3. Restart both servers
# VITE_USE_COOKIES=true
